{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpg.local/schemas/main-menu.schema.json",
  "title": "Virtual Pro Grappler Main Menu",
  "description": "Schema for the top-level main menu data used by the VPG UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "pages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pages": {
      "type": "object",
      "description": "Named main menu pages keyed by camelCase page id.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "headingImage",
        "menuItems"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeCaseId"
        },
        "displayName": {
          "$ref": "#/$defs/displayText"
        },
        "headingImage": {
          "description": "Runtime artwork, or null to display the page name as text.",
          "anyOf": [
            {
              "$ref": "#/$defs/assetPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "menuItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/menuItem"
          }
        }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "target",
        "instructions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/snakeCaseId"
        },
        "displayName": {
          "$ref": "#/$defs/displayText"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "instructions": {
          "$ref": "#/$defs/instructions"
        }
      }
    },
    "target": {
      "description": "Where selecting the item goes. Either a bare camelCase key in `pages`, which navigates to that page, or a dot-delimited route id handled by the application.",
      "type": "string",
      "anyOf": [
        {
          "title": "Page key",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        {
          "title": "Route id",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        }
      ]
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "blocks"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/displayText"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instructionBlock"
          }
        }
      }
    },
    "instructionBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "$ref": "#/$defs/definitionListBlock"
        }
      ]
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "$ref": "#/$defs/displayText"
        }
      }
    },
    "definitionListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "definitionList"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definitionListItem"
          }
        }
      }
    },
    "definitionListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "definition"
      ],
      "properties": {
        "term": {
          "$ref": "#/$defs/displayText"
        },
        "definition": {
          "$ref": "#/$defs/displayText"
        }
      }
    },
    "displayText": {
      "type": "string",
      "minLength": 1
    },
    "assetPath": {
      "type": "string",
      "pattern": "^assets/.+\\.(png|jpg|jpeg|webp|gif)$"
    },
    "snakeCaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
