{
  "$schema": "../../schemas/main-menu.schema.json",
  "version": "1.0.0",
  "pages": {
    "mainMenu": {
      "id": "main_menu",
      "displayName": "Main Menu",
      "headingImage": "assets/ui/textures/artwork/vpg-logo.png",
      "menuItems": [
        {
          "id": "multi_play",
          "displayName": "Multi Play",
          "target": "multiPlay",
          "instructions": {
            "title": "<< Multi Play >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Open multiplayer match types and events."
              }
            ]
          }
        },
        {
          "id": "single_play",
          "displayName": "Single Play",
          "target": "singlePlay",
          "instructions": {
            "title": "<< Single Play >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Open single-player game modes."
              }
            ]
          }
        },
        {
          "id": "commissioner",
          "displayName": "Commissioner",
          "target": "commissioner",
          "instructions": {
            "title": "<< Commissioner >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Open setup, options, arena viewer, and controls."
              }
            ]
          }
        },
        {
          "id": "exit",
          "displayName": "Exit",
          "target": "session.exit",
          "instructions": {
            "title": "<< Exit >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Save your changes and finish this session, with an optional portable backup."
              }
            ]
          }
        }
      ]
    },
    "multiPlay": {
      "id": "multi_play",
      "displayName": "Multi Play",
      "headingImage": null,
      "menuItems": [
        {
          "id": "exhibition",
          "displayName": "Exhibition",
          "target": "match_setup.exhibition",
          "instructions": {
            "title": "<< Exhibition Mode >>",
            "blocks": [
              {
                "type": "definitionList",
                "items": [
                  {
                    "term": "Single Match",
                    "definition": "1 vs. 1"
                  },
                  {
                    "term": "Tag Match",
                    "definition": "2 vs. 2"
                  },
                  {
                    "term": "Triple Threat Match",
                    "definition": "1 vs. 1 vs. 1"
                  },
                  {
                    "term": "Handicap Match",
                    "definition": "2 vs. 1"
                  },
                  {
                    "term": "Cage Match",
                    "definition": "1 vs. 1"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "royal_rumble",
          "displayName": "Royal Rumble",
          "target": "match_setup.royal_rumble",
          "instructions": {
            "title": "<< Royal Rumble Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Four Superstars do battle until one Superstar survives all. Players can select the number of participants in the event. Up to 40 Superstars can participate."
              },
              {
                "type": "paragraph",
                "text": "When a player is eliminated, a new Superstar will come out of the locker room to join the match."
              }
            ]
          }
        },
        {
          "id": "pay_per_view",
          "displayName": "Pay-Per-View",
          "target": "match_setup.pay_per_view",
          "instructions": {
            "title": "<< Pay-Per-View Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Players can set up the name of the event, date, location, number of matches, and the match types."
              },
              {
                "type": "paragraph",
                "text": "It is possible to recreate historic shows from the past, or create an original show."
              }
            ]
          }
        },
        {
          "id": "king_of_the_ring",
          "displayName": "King of the Ring",
          "target": "match_setup.king_of_the_ring",
          "instructions": {
            "title": "<< King of the Ring Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "The tournament to crown a new King of the Ring."
              },
              {
                "type": "paragraph",
                "text": "3 to 16 Superstars may participate in this event."
              }
            ]
          }
        },
        {
          "id": "guest_referee",
          "displayName": "Guest Referee",
          "target": "match_setup.guest_referee",
          "instructions": {
            "title": "<< Guest Referee Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Be a referee in a match."
              },
              {
                "type": "paragraph",
                "text": "Call it right down the middle and try not to get distracted."
              }
            ]
          }
        },
        {
          "id": "ladder_match",
          "displayName": "Ladder Match",
          "target": "match_setup.ladder_match",
          "instructions": {
            "title": "<< Ladder Match Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "The first player to climb up the ladder and get the belt can leave the event with it."
              }
            ]
          }
        },
        {
          "id": "ironman_match",
          "displayName": "Ironman Match",
          "target": "match_setup.ironman_match",
          "instructions": {
            "title": "<< Ironman Match Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Two Superstars do battle to decide who is better."
              },
              {
                "type": "paragraph",
                "text": "The Superstar with the most falls in time limit. A fall is scored when a competitor is disqualified, submits, gets knocked out, or is pinned to the mat for a count of 3."
              }
            ]
          }
        }
      ]
    },
    "singlePlay": {
      "id": "single_play",
      "displayName": "Single Play",
      "headingImage": null,
      "menuItems": [
        {
          "id": "championship",
          "displayName": "Championship",
          "target": "single_play.championship",
          "instructions": {
            "title": "<< Championship Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "This is a quest mode. There are different scenarios for each of the championship belts in the World Wrestling Federation."
              },
              {
                "type": "paragraph",
                "text": "Difficulty setting of Superstars, scenarios, and events are different depending on the World Wrestling Federation title. Choose a belt and see if you can walk the long road to a World Wrestling Federation title."
              }
            ]
          }
        },
        {
          "id": "survival",
          "displayName": "Survival",
          "target": "single_play.survival",
          "instructions": {
            "title": "<< Survival Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Choose a Superstar and run the gauntlet of 100 participants."
              },
              {
                "type": "paragraph",
                "text": "How many Superstars can you defeat, and how much money can you earn?"
              }
            ]
          }
        }
      ]
    },
    "commissioner": {
      "id": "commissioner",
      "displayName": "Commissioner",
      "headingImage": null,
      "menuItems": [
        {
          "id": "options",
          "displayName": "Options",
          "target": "options",
          "instructions": {
            "title": "<< Options Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Manage local saves and portable backups."
              }
            ]
          }
        },
        {
          "id": "animation_viewer",
          "displayName": "Animation Viewer",
          "target": "commissioner.animation_viewer",
          "instructions": {
            "title": "<< Animation Viewer >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Play any animation clip on any character model. Clips are retargeted to each character's proportions."
              },
              {
                "type": "definitionList",
                "items": [
                  {
                    "term": "Left / Right",
                    "definition": "Previous / next clip"
                  },
                  {
                    "term": "Start",
                    "definition": "Play / pause"
                  },
                  {
                    "term": "B",
                    "definition": "Back to the menu"
                  },
                  {
                    "term": "Mouse",
                    "definition": "Drag to orbit, scroll to zoom"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "arena_viewer",
          "displayName": "Arena Viewer",
          "target": "commissioner.arena_viewer",
          "instructions": {
            "title": "<< Arena Viewer >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "View every arena: the bundled ones and those you have saved in this browser."
              },
              {
                "type": "definitionList",
                "items": [
                  {
                    "term": "Control Stick",
                    "definition": "Orbit the camera"
                  },
                  {
                    "term": "C-Up / C-Down",
                    "definition": "Zoom in / out"
                  },
                  {
                    "term": "Mouse",
                    "definition": "Drag to orbit, scroll to zoom"
                  },
                  {
                    "term": "B",
                    "definition": "Close the arena, then back to the menu"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "arena_editor",
          "displayName": "Arena Editor",
          "target": "commissioner.arena_editor",
          "instructions": {
            "title": "<< Arena Editor >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Create and edit custom arenas with a live preview. Bundled arenas are cloned before editing. Arenas and imported images are saved in this browser."
              },
              {
                "type": "definitionList",
                "items": [
                  {
                    "term": "D-Pad",
                    "definition": "Move between fields / change a value"
                  },
                  {
                    "term": "A",
                    "definition": "Press a button or start typing"
                  },
                  {
                    "term": "Z",
                    "definition": "Save (on the list: clone)"
                  },
                  {
                    "term": "Control Stick / C",
                    "definition": "Orbit / zoom the preview"
                  },
                  {
                    "term": "B",
                    "definition": "Stop typing, close the draft, then back"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "character_editor",
          "displayName": "Character Editor",
          "target": "commissioner.character_editor",
          "instructions": {
            "title": "<< Character Editor >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Create and customize wrestlers assembled onto the 71-bone VPG Rig 2.0. Preview any VPG animation clip, save custom wrestlers in this browser, or export a VPG Rig 2.0 GLB."
              },
              {
                "type": "definitionList",
                "items": [
                  {
                    "term": "Mouse",
                    "definition": "Drag to orbit, scroll to zoom the 3D stage"
                  },
                  {
                    "term": "C Buttons",
                    "definition": "Orbit / zoom the camera"
                  },
                  {
                    "term": "Start",
                    "definition": "Play / pause animation"
                  },
                  {
                    "term": "B",
                    "definition": "Back to the menu"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "controls",
          "displayName": "Controls",
          "target": "commissioner.controls",
          "instructions": {
            "title": "<< Controls Mode >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Set the inputs and controls for Virtual Pro Grappler."
              }
            ]
          }
        }
      ]
    },
    "options": {
      "id": "options",
      "displayName": "Options",
      "headingImage": null,
      "menuItems": [
        {
          "id": "save_data",
          "displayName": "Save Data",
          "target": "commissioner.save_data",
          "instructions": {
            "title": "<< Save Data >>",
            "blocks": [
              {
                "type": "paragraph",
                "text": "Select local saves, download or restore a .vpg backup, and configure backup reminders."
              }
            ]
          }
        }
      ]
    }
  }
}
